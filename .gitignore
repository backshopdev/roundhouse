# Agent scratch space: ignore contents but keep the folder in-repo
scratch/*
**/scratch/*
!scratch/.gitkeep
!**/scratch/.gitkeep
!src/scratch/README.md

# Dependency caches
node_modules/
.yarn/

# Environment files: read is denied; grep requires human confirmation
# Ignore rules add traversal defense in depth; they are not path-aware tool denial
.env
.env.*
**/.env
**/.env.*
.settings.local

# Root .opencode/ is a deployed instance of src/.opencode/; never track directly.
# Changes belong in src/.opencode/ and are synced here by `npm run sync-roundhouse`.
/.opencode/

# Root opencode.json is a deployed instance of src/opencode.json; never track directly.
# Changes belong in src/opencode.json and are synced here by `npm run sync-roundhouse`.
/opencode.json

# Build output
dist/
build/

# KTLO: template items are authored & committed (ktlo/00X, index.md).
# Only genuinely-generated per-session KTLO scratch stays ignored.
ktlo/scratch/

# Workflow state (generated per session)
WORKFLOW_STATE.md

# Editor/IDE specific
.vscode/
.idea/
*.swp
*.swo
*~
